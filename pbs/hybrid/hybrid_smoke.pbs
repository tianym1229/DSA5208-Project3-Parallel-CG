#!/bin/bash
#PBS -P personal-tianyimeng
#PBS -N pfa_hybrid_smoke
#PBS -l select=1:ncpus=4:mpiprocs=4:ompthreads=1:mem=8gb:node_pool=cpu_node
#PBS -l walltime=00:20:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"

module load openmpi/gcc/64/4.1.8

MPI_PREFIX=/cm/shared/apps/openmpi4/gcc/4.1.8
export PATH="$MPI_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$MPI_PREFIX/lib:${LD_LIBRARY_PATH:-}"

export OMP_DYNAMIC=FALSE
export OMP_PLACES=cores
export OMP_PROC_BIND=close

OUT="$PBS_O_WORKDIR/results/analysis/hybrid/smoke"
mkdir -p "$OUT"

echo "===== HYBRID CLEAN BUILD SMOKE TEST ====="
echo "JOBID=$PBS_JOBID"
echo "HOST=$(hostname)"
echo "PROJECT_ROOT=$PBS_O_WORKDIR"

echo "===== BUILD MPI AND HYBRID EXECUTABLES ====="
make -j1 cg_mpi cg_hybrid

echo "===== VERIFY EXECUTABLES ====="
test -x cg_mpi
test -x cg_hybrid
ls -lh cg_mpi cg_hybrid

echo "===== RUN HYBRID CORRECTNESS TESTS ====="
python3 -u tests/test_hybrid.py

echo "===== HYBRID SMOKE TEST PASSED ====="
