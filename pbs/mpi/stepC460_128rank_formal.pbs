#!/bin/bash
#PBS -P personal-tianyimeng
#PBS -N cg_C460_128formal
#PBS -l select=4:ncpus=32:mpiprocs=32:ompthreads=1:mem=32gb:node_pool=cpu_node
#PBS -l place=scatter
#PBS -l walltime=00:20:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

MPI_PREFIX=/cm/shared/apps/openmpi4/gcc/4.1.8
export PATH="$MPI_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$MPI_PREFIX/lib:${LD_LIBRARY_PATH:-}"

echo "===== BUILD EXECUTABLE ====="
make -j1 cg_mpi
test -x cg_mpi
echo "===== BUILD COMPLETED ====="
export OMP_NUM_THREADS=1
export OMP_PLACES=cores
export OMP_PROC_BIND=close

OUTDIR="results/formal/mpi/strong_scaling/stepC460_128rank_formal"
mkdir -p "$OUTDIR"
OUT="$OUTDIR/results_${PBS_JOBID%%.*}.csv"

echo "===== 128-RANK FORMAL EXPERIMENT ====="
echo "===== NODE ALLOCATION ====="
sort "$PBS_NODEFILE" | uniq -c

echo "===== MPI VERSION ====="
mpirun --version | head -n 1

echo "===== EXPERIMENT CONFIG ====="
echo "ranks=64"
echo "warmup=1"
echo "measurements=5"

echo "dim,grid,n,nnz,solution,ranks,iterations,runtime_s,relative_residual,relative_error,converged,halo_s,spmv_s,allreduce_s,vector_s,comm,fixed_iters,validation_s,omp_threads,phase,repeat" > "$OUT"

run_case() {
    local dim="$1"
    local grid="$2"
    local comm="$3"
    local phase="$4"
    local repeat="$5"

    echo "===== dim=$dim grid=$grid comm=$comm phase=$phase repeat=$repeat START ====="

    mpirun \
        --prefix "$MPI_PREFIX" \
        --hostfile "$PBS_NODEFILE" \
        --map-by ppr:32:node \
        --bind-to core \
        -np 128 \
        ./cg_mpi \
        --dim "$dim" \
        --grid "$grid" \
        --solution benchmark \
        --comm "$comm" \
        --tol 1e-8 \
        --max-iters 10000 \
    | awk -F',' \
        -v out="$OUT" \
        -v phase="$phase" \
        -v rep="$repeat" \
        -v expected_dim="$dim" \
        -v expected_grid="$grid" \
        -v expected_comm="$comm" '
        BEGIN {
            count=0
            invalid=0
        }

        $1 ~ /^[23]$/ && NF==19 {
            count++

            numeric_ok = ($7 ~ /^[0-9]+$/ && $8 ~ /^[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$/ && $9 ~ /^[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$/ && $10 ~ /^[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$/)

            if ($1 != expected_dim ||
                $2 != expected_grid ||
                $6 != 128 ||
                $7+0 <= 0 ||
                $11 != 1 ||
                !numeric_ok ||
                $9+0 >= 1e-8 ||
                $8+0 <= 0 ||
                $10+0 < 0 ||
                $16 != expected_comm) {
                invalid++
            }

            row=$0
        }

        END {
            if (count != 1 || invalid != 0)
                exit 1

            print row "," phase "," rep >> out
        }
    '

    echo "===== dim=$dim grid=$grid comm=$comm phase=$phase repeat=$repeat SUCCESS ====="
}

for case in "2 512" "3 64"; do
    read -r dim grid <<< "$case"

    for comm in baseline overlap; do

        run_case "$dim" "$grid" "$comm" warmup 0

        for repeat in 1 2 3 4 5; do
            run_case "$dim" "$grid" "$comm" measure "$repeat"
        done

    done
done

echo "===== STEP C4.5.5.11 FORMAL EXPERIMENT COMPLETED ====="
echo "CSV=$OUT"
